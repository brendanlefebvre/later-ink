# --- Self-host (single user): just set your Readwise token.
# Get it at https://readwise.io/access_token
# Your catalog will be at http://your-host:8000/opds/
READWISE_TOKEN=your_readwise_access_token_here
# Readwise categories to serve. Default: all supported
# (article,email,pdf,epub,video,tweet,podcast)
#READWISE_CATEGORIES=article,pdf

# --- Wallabag connector (optional, self-host) ---
# Serve a Wallabag account alongside (or instead of) Readwise. Create an API
# client in Wallabag under Developer → Create a new client to get the id/secret.
# All five must be set for the connector to appear.
# NOTE: Wallabag's API (OAuth2 password grant) needs your actual account
# username and password — unlike a revocable Readwise token, so keep this .env
# readable only by you (e.g. chmod 600) and out of version control.
#WALLABAG_URL=https://wallabag.example.com
#WALLABAG_CLIENT_ID=your_client_id
#WALLABAG_CLIENT_SECRET=your_client_secret
#WALLABAG_USERNAME=your_wallabag_username
#WALLABAG_PASSWORD=your_wallabag_password

# --- Hosted / multi-tenant mode (optional) ---
# Public base URL shown to users on the onboarding page
#BASE_URL=https://later.ink
# Stripe secret key used to verify Checkout Sessions
#STRIPE_SECRET_KEY=sk_live_...
# Stripe Payment Link shown on the landing page
#STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
# Or skip payments entirely (dev / friends & family)
#ALLOW_FREE_SIGNUP=1
# SQLite location (docker-compose sets this to /data/app.db)
#DATABASE_PATH=./data/app.db
# Fernet key for encrypting stored Readwise tokens at rest. REQUIRED once
# signups are enabled (ALLOW_FREE_SIGNUP or STRIPE_SECRET_KEY) — the app
# refuses to start without it, because an ephemeral key means every stored
# token is unreadable after a restart. Single-user self-hosting stores no
# tokens and doesn't need it. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#ENCRYPTION_KEY=
# Honor fly-client-ip / x-forwarded-for (only enable behind a trusted proxy)
#TRUST_PROXY_HEADERS=1
# Per-IP rate limits. Defaults suit a public instance; a real signup and a
# normal browsing session both stay well under them. Raise the feed limit if
# several of your devices share one address behind NAT, or set either to 0 to
# turn it off. Note that unknown-secret probes are throttled separately and
# always on — that limit is what makes short catalog secrets safe.
#RATE_LIMIT_FEED_PER_MIN=60
#RATE_LIMIT_SIGNUP_PER_HOUR=20
# Optional: server-side referrer log for the landing page (referer + user-agent,
# no IPs or cookies). When set, view the log at /stats?token=<this value>. Off by
# default — self-hosters collect nothing unless they set this.
#STATS_TOKEN=
# Optional: how many days of referrer-log hits to keep. Old rows are pruned on
# write. Defaults to 90; set 0 to keep everything (unbounded growth).
#STATS_RETENTION_DAYS=90
