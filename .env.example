# --- Self-host (single user): just set your Readwise token.
# Get it at https://readwise.io/access_token
# Your catalog will be at http://your-host:8000/opds/
READWISE_TOKEN=your_readwise_access_token_here

# --- Hosted / multi-tenant mode (optional) ---
# Public base URL shown to users on the onboarding page
#BASE_URL=https://later.ink
# Stripe secret key used to verify Checkout Sessions
#STRIPE_SECRET_KEY=sk_live_...
# Stripe Payment Link shown on the landing page
#STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
# Or skip payments entirely (dev / friends & family)
#ALLOW_FREE_SIGNUP=1
# SQLite location (docker-compose sets this to /data/app.db)
#DATABASE_PATH=./data/app.db
# Fernet key for encrypting stored Readwise tokens at rest. REQUIRED in
# production; without it an ephemeral key is used and tokens are lost on
# restart. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#ENCRYPTION_KEY=
# Honor fly-client-ip / x-forwarded-for (only enable behind a trusted proxy)
#TRUST_PROXY_HEADERS=1
